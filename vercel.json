{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(brands|models|fuel|mileage|get-hotels|get-destination-places|recommend)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|brands|models|fuel|mileage|get-hotels|get-destination-places|recommend|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
